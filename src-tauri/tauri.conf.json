{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "muse-desktop",
  "version": "0.1.0",
  "identifier": "com.tao.muse-desktop",
  "build": {
    "beforeDevCommand": null,
    "beforeBuildCommand": null,
    "devUrl": "https://muse.ai",
    "frontendDist": "https://muse.ai"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Muse",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": false,
        "center": true,
        "decorations": true,
        "visible": true,
        "label": "main",
        "url": "https://muse.ai",
        "userAgent": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity"
  }
}
