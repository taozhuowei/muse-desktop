{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Allow muse.ai to send desktop notifications",
  "local": false,
  "remote": {
    "urls": ["https://muse.ai", "https://muse.ai/*", "https://*.muse.ai/*"]
  },
  "webviews": ["main"],
  "permissions": [
    "core:event:default"
  ]
}